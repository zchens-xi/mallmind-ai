<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.service.dao.UmsMemberDao">
    <resultMap id="BaseResultMap" type="com.macro.mall.model.UmsMember">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="phone" property="phone" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="listAll" resultMap="BaseResultMap">
        SELECT * FROM ums_member
    </select>

    <select id="getById" resultMap="BaseResultMap">
        SELECT * FROM ums_member WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.macro.mall.model.UmsMember">
        INSERT INTO ums_member
            (username, password, phone, email, status, create_time)
        VALUES
            (#{username}, #{password}, #{phone}, #{email}, #{status}, #{createTime})
    </insert>

    <update id="update" parameterType="com.macro.mall.model.UmsMember">
        UPDATE ums_member
        SET username = #{username},
            password = #{password},
            phone = #{phone},
            email = #{email},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM ums_member WHERE id = #{id}
    </delete>
</mapper>